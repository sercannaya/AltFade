{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AltFade",
  "version": "1.1.1",
  "identifier": "com.sercannaya.altfade",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "AltFade",
        "width": 480,
        "height": 760,
        "resizable": false,
        "center": true,
        "visible": false,
        "transparent": true,
        "windowEffects": {
          "effects": ["mica"]
        }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ1NDNDOTgxOEE4NEVCQTMKUldTajY0U0tnY2xEUlhOUm5qUzlaTGRPTStPb0RKWVBFbTlDc1Vkdk1WOXlDRTFucTVSdUtaVi8K",
      "endpoints": [
        "https://github.com/sercannaya/AltFade/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Sercan Naya",
    "copyright": "Copyright © 2026 Sercan Naya",
    "category": "Utility",
    "shortDescription": "Auto-duck game audio when media plays",
    "longDescription": "AltFade automatically lowers your game's volume when YouTube, Spotify or any media starts playing, then smoothly fades it back when you pause.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English", "Turkish"],
        "displayLanguageSelector": true
      }
    }
  }
}
