{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AltFade",
  "version": "1.0.0",
  "identifier": "com.sercannaya.altfade",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "AltFade",
        "width": 480,
        "height": 620,
        "resizable": false,
        "center": true
      }
    ],
    "trayIcon": {
      "iconPath": "icons/32x32.png",
      "iconAsTemplate": false
    },
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Sercan Naya",
    "copyright": "Copyright © 2026 Sercan Naya",
    "category": "Utility",
    "shortDescription": "Auto-duck game audio when media plays",
    "longDescription": "AltFade automatically lowers your game's volume when YouTube, Spotify or any media starts playing, then smoothly fades it back when you pause.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English", "Turkish"],
        "displayLanguageSelector": true
      }
    }
  }
}
